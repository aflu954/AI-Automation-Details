    {
      "parameters": {
        "jsCode": "const output = [];\nconst seen = new Set();\n\nfunction clean(str) {\n  return String(str ?? \"\").trim().replace(/\\s+/g, \" \");\n}\n\nfunction properCase(str) {\n  return clean(str)\n    .toLowerCase()\n    .replace(/\\b\\w/g, c => c.toUpperCase());\n}\n\nfunction fixEmail(email) {\n  email = clean(email).toLowerCase();\n\n  if (!email || email === \"(missing)\" || email === \"missing\") {\n    return \"missing@example.com\";\n  }\n\n  if (!email.includes(\"@\")) {\n    return email + \"@example.com\";\n  }\n\n  const parts = email.split(\"@\");\n\n  if (!parts[1].includes(\".\")) {\n    return email + \".com\";\n  }\n\n  return email;\n}\n\nfunction fixPhone(phone) {\n  phone = String(phone ?? \"\").replace(/\\D/g, \"\");\n\n  if (phone.length === 10) {\n    phone = \"0\" + phone;\n  }\n\n  return phone;\n}\n\nfunction formatDate(value) {\n\n  value = clean(value);\n\n  // DD/MM/YYYY\n  if (/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(value)) {\n    const [d, m, y] = value.split(\"/\");\n    return `${y}-${m}-${d}`;\n  }\n\n  // DD-MM-YYYY\n  if (/^\\d{2}-\\d{2}-\\d{4}$/.test(value)) {\n    const [d, m, y] = value.split(\"-\");\n    return `${y}-${m}-${d}`;\n  }\n\n  const d = new Date(value);\n\n  if (isNaN(d)) return \"\";\n\n  return d.toISOString().split(\"T\")[0];\n}\n\nlet id = 1;\n\nfor (const item of items) {\n\n  let name = properCase(item.json[\"Full Name\"]);\n  let email = fixEmail(item.json[\"Email\"]);\n  let phone = fixPhone(item.json[\"Phone\"]);\n  let city = properCase(item.json[\"City\"]);\n  let date = formatDate(item.json[\"Registration Date\"]);\n\n  // Remove only completely empty rows\n  if (!name && !email && !phone) continue;\n\n  // Duplicate check\n  const key = email + \"_\" + phone;\n\n  if (seen.has(key)) {\n    continue;\n  }\n\n  seen.add(key);\n\n  output.push({\n    json: {\n      \"Customer ID\": \"CUST-\" + String(id).padStart(4, \"0\"),\n      \"Full Name\": name,\n      \"Email\": email,\n      // Leading zero যেন Google Sheets না কাটে\n      \"Phone\": \"'\" + phone,\n      \"City\": city,\n      \"Registration Date\": date\n    }\n  });\n\n  id++;\n}\n\nreturn output;"
      },
